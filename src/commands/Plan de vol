import { EmbedBuilder, MessageFlags } from 'discord.js';
import { InteractionHelper } from '../../../utils/interactionHelper.js';
import { logger } from '../../../utils/logger.js';

/**
 * Crée l'embed du plan de vol
 */
function createFlightPlanEmbed({
  pilot,
  copilote = 'N/A',
  code,
  modele,
  compagnie,
  porte,
  depart,
  destination,
  alternatif,
  typeVol,
  etat,
  heureEmbarquement,
}) {
  const embed = new EmbedBuilder()
    .setTitle('✈️ PLAN DE VOL ENREGISTRÉ')
    .setDescription('Le plan a été envoyé au système. Attendez qu\'un Administrateur l\'approuve.')
    .setColor(0x1a1a1a)
    .addFields(
      { name: '👨‍✈️ PILOTE', value: `${pilot}`, inline: false },
      { name: '👨‍✈️ COPILOTE', value: copilote || 'N/A', inline: false },
      { name: '🆔 CODE DE VOL', value: code, inline: false },
      { name: '✈️ MODÈLE D\'AVION', value: modele, inline: false },
      { name: '🏢 COMPAGNIE AÉRIENNE', value: compagnie, inline: false },
      { name: '🚪 PORTE D\'EMBARQUEMENT', value: porte, inline: false },
      { name: '🛫 DÉPART', value: depart, inline: false },
      { name: '🛬 DESTINATION', value: destination, inline: false },
      { name: '🔄 ALTERNATIF', value: alternatif, inline: false },
      { name: '📦 TYPE DE VOL', value: typeVol, inline: false },
      { name: '📍 ÉTAT ACTUEL', value: etat, inline: false },
      { name: '⏰ HEURE D\'EMBARQUEMENT', value: heureEmbarquement, inline: false },
    )
    .setFooter({ text: 'BLOXWINGS BOT' })
    .setTimestamp();

  return embed;
}

export default {
  prefixOnly: false,

  async execute(interaction, config, client) {
    try {
      const code = interaction.options.getString('code')?.toUpperCase();
      const modele = interaction.options.getString('modele')?.toUpperCase();
      const compagnie = interaction.options.getString('compagnie')?.toUpperCase();
      const porte = interaction.options.getString('porte');
      const depart = interaction.options.getString('depart')?.toUpperCase();
      const destination = interaction.options.getString('destination')?.toUpperCase();
      const alternatif = interaction.options.getString('alternatif')?.toUpperCase();
      const typeVol = interaction.options.getString('type_vol')?.toUpperCase();
      const etat = interaction.options.getString('etat')?.toUpperCase();
      const heureEmbarquement = interaction.options.getString('heure_embarquement');
      const copilote = interaction.options.getString('copilote') || 'N/A';

      const embed = createFlightPlanEmbed({
        pilot: interaction.user,
        copilote,
        code,
        modele,
        compagnie,
        porte,
        depart,
        destination,
        alternatif,
        typeVol,
        etat,
        heureEmbarquement,
      });

      await interaction.reply({ embeds: [embed] });

      // Message de confirmation (comme dans le screenshot)
      await interaction.followUp({
        content: `✅ **${interaction.user.displayName}** a utilisé \`plan_de_vol\``,
      });
    } catch (error) {
      logger.error('plan_de_vol error:', error);
      await InteractionHelper.safeReply(interaction, {
        content: '❌ Une erreur est survenue lors de l\'enregistrement du plan de vol.',
        flags: MessageFlags.Ephemeral,
      });
    }
  },
};
